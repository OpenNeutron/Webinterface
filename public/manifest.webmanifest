{
  "name": "Sloth Lee Mail",
  "short_name": "Sloth Mail",
  "description": "Encrypted mail at slothlee.xyz. Messages are decrypted in your browser, never on the server.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#10150f",
  "theme_color": "#10150f",
  "categories": ["email", "productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Compose", "short_name": "Compose", "url": "/?compose=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
